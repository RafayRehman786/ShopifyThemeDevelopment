<h1>{{ section.settings.heading_text }}</h1>


{% for block in section.blocks %}
    <h3>{{ block.type }}</h3>
{% endfor %}
{% style %}
  h1 {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.heading_color }};
  }
{% endstyle %}


{% schema %}

{

  "name": "Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "Hello world"
    },
    {
        "type": "color",
       "id": "heading_color",
        "label": "Heading Color",
        "default": "#db4444"
    
    },   {
        "type": "color",
       "id": "background_color",
        "label": "Background Color",
        "default": "#9c9c9c"
    
    }
  ],
  "blocks": [
    {
        "type": "title",
        "name": "Title",
        "settings": [
            {
                "type": "text",
                "id": "title_text",
                "label": "Title Text",
                "default": "Hello world"
            },
                {
        "type": "color",
       "id": "title_color",
        "label": "Title Color",
        "default": "#db4444"
    
    },   {
        "type": "color",
       "id": "title_background_color",
        "label": "Title Background Color",
        "default": "#9c9c9c"
    
    }
        ]
    
    }
  ],
    "presets": [
        {
        "name": "Heading"
        }
    ]
}


{% endschema %}